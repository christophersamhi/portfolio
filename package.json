{
	"name": "mon-projet",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"dev": "vite",
		"build:css": "sass app/styles:dist/styles --no-source-map",
		"build:js": "vite build",
		"build": "npm run build:js && npm run build:css",
		"build-prod": "vite build --config vite.config.prod.js",
		"preview": "vite preview",
		"lint": "eslint \"app/scripts/*.js\"",
		"lint:fix": "eslint \"app/scripts/*.js\" --fix",
		"lint:css": "stylelint \"app/styles/*.scss\"",
		"lint:css:fix": "stylelint \"app/styles/*.scss\" --fix",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,scss}": [
			"prettier --write",
			"stylelint --fix",
			"eslint --fix"
		],
		"*.html": [
			"prettier --write"
		]
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@typescript-eslint/eslint-plugin": "^8.48.0",
		"@typescript-eslint/parser": "^8.48.0",
		"cssnano": "^7.1.2",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-n": "^17.23.1",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-promise": "^7.2.1",
		"fs-extra": "^11.3.2",
		"glob": "^13.0.0",
		"html-minifier": "^4.0.0",
		"html-minifier-terser": "^7.2.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"postcss": "^8.5.6",
		"postcss-scss": "^4.0.9",
		"prettier": "^3.6.2",
		"sass": "^1.94.2",
		"stylelint": "^16.26.0",
		"stylelint-config-standard-scss": "^16.0.0",
		"stylelint-order": "^7.0.0",
		"stylelint-scss": "^6.12.1",
		"typescript": "^5.9.3",
		"vite": "^7.2.4",
		"vite-plugin-html-minifier": "^1.0.5",
		"vite-plugin-static-copy": "^3.1.4"
	},
	"dependencies": {
		"jquery": "^3.7.1",
		"swiper": "^12.1.4"
	}
}
